# RAYA enquiry form — Google Apps Script web-app /exec endpoint (RAYA-specific)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# RAYA WhatsApp enquiry number, international format, digits only (e.g. 62812xxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Mapbox (shared RBG token, same as azurea/allurea)
NEXT_PUBLIC_MAPBOX_TOKEN=
